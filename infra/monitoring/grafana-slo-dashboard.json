{
  "dashboard": {
    "title": "ProjectX SLO Dashboard",
    "uid": "projectx-slo",
    "timezone": "utc",
    "refresh": "30s",
    "panels": [
      {
        "title": "API Availability (30d SLO: 99.9%)",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "avg(projectx:availability:ratio_rate5m{job=\"api-gateway\"}) * 100",
            "legendFormat": "Availability %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "orange", "value": 99.5 },
                { "color": "green", "value": 99.9 }
              ]
            },
            "unit": "percent",
            "min": 99,
            "max": 100
          }
        }
      },
      {
        "title": "Error Budget Remaining (30d)",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
        "targets": [
          {
            "expr": "1 - ((1 - avg(projectx:availability:ratio_rate5m{job=\"api-gateway\"})) / (1 - 0.999))",
            "legendFormat": "Budget Remaining"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "orange", "value": 0.25 },
                { "color": "green", "value": 0.5 }
              ]
            }
          }
        }
      },
      {
        "title": "P99 Latency by Service",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "projectx:http_latency:p99_5m",
            "legendFormat": "{{ job }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2
            }
          }
        }
      },
      {
        "title": "Request Rate by Service",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "projectx:http_requests:rate5m",
            "legendFormat": "{{ job }}"
          }
        ]
      },
      {
        "title": "Error Rate (5xx) by Service",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "projectx:http_errors:rate5m",
            "legendFormat": "{{ job }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 20
            },
            "color": { "mode": "fixed", "fixedColor": "red" }
          }
        }
      },
      {
        "title": "AI Service Response Time (P50 / P95 / P99)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum by (le)(rate(http_server_requests_seconds_bucket{job=\"ai-service\"}[5m])))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, sum by (le)(rate(http_server_requests_seconds_bucket{job=\"ai-service\"}[5m])))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, sum by (le)(rate(http_server_requests_seconds_bucket{job=\"ai-service\"}[5m])))",
            "legendFormat": "P99"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "s" }
        }
      }
    ]
  }
}
